<Window x:Class="DoYourTask_Reloaded.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="350" Width="525"
        MinWidth="681.6" MinHeight="440">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Name="page_title" Background="#333333" Grid.Row="0">
            <TextBlock Text="DoYourTask" TextAlignment="Left" Margin="0 10" FontFamily="pack://application:,,,/Fonts/Montserrat-VariableFont_wght.ttf#Montserrat" FontWeight="Bold" FontSize="48" Foreground="MediumAquamarine" />
        </StackPanel>

        <Grid Grid.Row="1" Background="#333333">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="#333333">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Tasks in progress" Grid.Row="0" VerticalAlignment="Top" Margin="10" Foreground="White" />
                <ListBox Name="tasks_list" Grid.Row="1" Margin="10">
                    <ListBoxItem>ListBox Item #1</ListBoxItem>
                    <ListBoxItem>ListBox Item #2</ListBoxItem>
                    <ListBoxItem>ListBox Item #3</ListBoxItem>
                </ListBox>
            </Grid>

            <Grid Grid.Column="1" Background="#333333">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button Name="add_button" Grid.Row="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="10" MinWidth="100" MinHeight="30" MaxWidth="200" MaxHeight="50">
                    <TextBlock TextWrapping="Wrap" Text="Add" />
                </Button>

                <Button Name="remove_button" Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="10" MinWidth="100" MinHeight="30" MaxWidth="200" MaxHeight="50">
                    <TextBlock TextWrapping="Wrap" Text="Remove" />
                </Button>

                <Button Grid.Row="2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="10" MinWidth="100" MinHeight="30" MaxWidth="200" MaxHeight="50">
                    <TextBlock TextWrapping="Wrap" Text="Informations" />
                </Button>
            </Grid>

            <Grid Grid.Column="2" Background="#333333">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="10 5" Orientation="Vertical">
                    <Label Content="Task name" Foreground="White" />
                    <TextBox Name="task_name_textbox" MinWidth="200" MinHeight="25" MaxWidth="400" VerticalAlignment="Top" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="10 5" Orientation="Vertical">
                    <Label Content="Task description" Foreground="White" />
                    <TextBox MinWidth="200" MinHeight="25" MaxWidth="400" VerticalAlignment="Top" Height="100" />
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="10 5" Orientation="Vertical">
                    <Label Content="DueDate" Foreground="White" />
                    <DatePicker MinWidth="200" MinHeight="25" MaxWidth="400" VerticalAlignment="Top" />
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="10 5" Orientation="Vertical">
                    <Label Content="Priority" Foreground="White" />
                    <ComboBox MinWidth="200" MinHeight="25" MaxWidth="400" VerticalAlignment="Top">
                        <!-- Add ComboBox items here -->
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>